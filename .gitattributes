# Normalize line endings: LF in the repository and in the working tree.
# Without this, a Windows build/install rewrites files as CRLF and every
# `git diff` drowns in whole-file changes that carry no content.
* text=auto eol=lf

# Keep Windows-only tooling in its native form.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.rar binary
*.zip binary
*.ase binary
*.aseprite binary
